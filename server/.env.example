# Optional Numerai API credentials. Every query reads public data, which Numerai
# serves anonymously, so leave these blank unless that changes; they are sent
# only when both are set.
NUMERAI_PUBLIC_KEY=
NUMERAI_SECRET_KEY=

# Origins allowed to call this API — the deployed frontend, and local dev.
ALLOWED_ORIGINS=https://numerdiff.imperialai.ai,http://localhost:5173
ALLOWED_ORIGIN_SUFFIXES=.numerai-model-reviewer.pages.dev

# Host directory for the SQLite file, and the host user that owns it. Unset,
# a named Docker volume and the image's own user are used.
# DATA_DIR=/data/numerai/numerdiff
# APP_UID=990
# APP_GID=990

# Scheduler (nightly precompute + backup). Defaults lift the D1-era caps.
# PRECOMPUTE_TOURNAMENTS=8 11 12
# PRECOMPUTE_TOP_N=1000000
# PRECOMPUTE_BACKFILL_ROUNDS=5000
# PRECOMPUTE_REFRESH_OVERLAP=70
# BACKUP_KEEP=7

# Cloudflare Tunnel token, for the opt-in `tunnel` profile.
TUNNEL_TOKEN=

# Optional overrides
# NUMERAI_API_URL=https://api-tournament.numer.ai/graphql
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
