# Numerai API credentials (same values as the worker's wrangler secrets).
NUMERAI_PUBLIC_KEY=
NUMERAI_SECRET_KEY=

# Origins allowed to call this API — the deployed frontend, and local dev.
ALLOWED_ORIGINS=https://numerdiff.imperialai.ai,http://localhost:5173
ALLOWED_ORIGIN_SUFFIXES=.numerai-model-reviewer.pages.dev

# Cloudflare Tunnel token, if you use the bundled tunnel service.
TUNNEL_TOKEN=

# Optional overrides
# NUMERAI_API_URL=https://api-tournament.numer.ai/graphql
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60
