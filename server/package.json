{
  "name": "numerai-api-server",
  "version": "1.0.0",
  "description": "Self-hosted Numerai API: the Cloudflare Worker's handler served from Node over SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  }
}
