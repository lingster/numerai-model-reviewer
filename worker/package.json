{
  "name": "numerai-api-proxy",
  "version": "1.0.0",
  "description": "Cloudflare Worker proxy for Numerai GraphQL API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
